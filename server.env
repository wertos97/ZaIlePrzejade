# ============================================================
# Lokalna konfiguracja serwera MPK
# ============================================================
# Skopiuj ten plik do `server.env` i dostosuj wartości.
# UWAGA: `server.env` jest ignorowany przez git (nie trafi do repo),
# dzięki czemu nie udostępniasz szczegółów swojego serwera publicznie.
#
#   cp server.env.example server.env
#
# Wszystkie zmienne są OPCJONALNE - jeśli nie ustawisz wartości,
# skrypty użyją bezpiecznych domyślnych wartości.

# Port, na którym działa aplikacja (domyślnie: 8080)
# Uwaga: server.py czyta PORT ze zmiennej środowiskowej.
PORT=8080

# Adres URL do sprawdzania zdrowia serwera (domyślnie: http://127.0.0.1:$PORT/api/health)
# Zwykle nie musisz tego zmieniać.
# HEALTH_URL=http://127.0.0.1:8080/api/health

# Nazwa gałęzi git do śledzenia aktualizacji (domyślnie: bieżąca gałąź)
# GIT_BRANCH=main

# Czy uruchamiać serwer w tle (nohup) - true/false (domyślnie: true)
# RUN_IN_BACKGROUND=true